{
  "name": "bigbuncher",
  "productName": "BigBuncher",
  "version": "1.1.0",
  "description": "BigBuncher — Minecraft Java Edition launcher",
  "author": "TambiStudio",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win portable",
    "assets": "py -3 scripts/prepare_assets.py",
    "release": "npm run dist && powershell -ExecutionPolicy Bypass -File scripts/publish-release.ps1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "6.1.2",
    "@xmcl/task": "4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "skinview3d": "^3.4.2",
    "three": "0.156.1",
    "undici": "6.21.3",
    "yauzl": "2.10.0"
  },
  "build": {
    "appId": "studio.tambi.bigbuncher",
    "productName": "BigBuncher",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "BigBuncher.exe"
    },
    "portable": {
      "artifactName": "BigBuncher.exe"
    },
    "asar": true,
    "npmRebuild": false
  },
  "overrides": {
    "@xmcl/installer": {
      "undici": "6.21.3"
    },
    "@xmcl/file-transfer": {
      "undici": "6.21.3"
    }
  }
}
